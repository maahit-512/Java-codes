class Childthread extends Thread {
    int row, col;
    int[][] A;
    int[][] B;
    int[][] C;
    Childthread(int row, int col, int[][] A, int[][] B, int[][] C) {
        this.row = row;
        this.col = col;
        this.A = A;
        this.B = B;
        this.C = C;
    }
    public void run() {
        try {
            C[row][col] = (A[row][0] * B[0][col]) + (A[row][1] * B[1][col]);
            Thread.sleep(500);
        } catch (InterruptedException e) {
            System.out.println("child interrupted");
        }
    }
}
